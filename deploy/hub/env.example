# NOT YET VERIFIED against a real box — written for §8.10 (B4); verify before first use.
# Install to /etc/multiplayer-ai/hub.env, then: chown mpai:mpai and chmod 0600.
# Never commit a filled-in copy of this file.
#
# Every var name below is character-for-character what poc/hub/src/hubEnv.ts and
# bootConfig.ts read. A malformed value REFUSES BOOT with a named error rather
# than silently defaulting (spec §3, B6) — that is the intended behaviour.

# Loopback only: the port must be reachable solely through Caddy. A non-loopback
# HOST with auth unconfigured REFUSES TO BOOT (hubEnv.ts, B6).
HOST=127.0.0.1
PORT=4000

# Optional. Absolute path to a built client for the hub to serve from the same
# origin. Leave unset if this hub only relays (browsers load the client
# elsewhere).
CLIENT_DIST=

# Where the record lives. MPAI_HOME anchors both hub.db and §8.3's machine.json
# under one dir, so a single value relocates identity and store together. Kept
# under /var (not the mpai home) because the systemd unit sets ProtectHome=true.
MPAI_HOME=/var/lib/multiplayer-ai
# Optional override of the db path alone; wins over MPAI_HOME. Verbatim, so
# ":memory:" means ephemeral (no persistence, no backups). Leave unset normally.
HUB_DB=

# ---------------------------------------------------------------------------
# GitHub sign-in. NOT YET VERIFIED against a real GitHub OAuth app.
#
# Auth is signalled by GITHUB_CLIENT_ID ALONE; once set, all four of
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET / SESSION_SECRET / GITHUB_ALLOWLIST
# are REQUIRED or the process exits 1 (a half-configured hub would silently run
# anonymous and look like a bug). In development you may omit all four.
#
# Register the OAuth app first: GitHub → Settings → Developer settings →
# OAuth Apps → New OAuth App.
#   Homepage URL:               https://hub.example.com
#   Authorization callback URL: https://hub.example.com/auth/callback   <- exact
# ---------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. HIGH ENTROPY, never a reused password:
#   openssl rand -hex 32
# There is no revocation list, so ROTATING THIS SIGNS EVERYONE OUT — which is
# also the only way to kill a leaked cookie. Trailing newlines are trimmed on
# load. Left blank on purpose; fill it in the deployed file only.
SESSION_SECRET=

# Who may drive. Comma-separated GitHub logins, case-insensitive, surrounding
# whitespace ignored. An EMPTY LIST ADMITS NOBODY — fail-closed, not a wildcard.
GITHUB_ALLOWLIST=

# Optional, but SET IT IN PRODUCTION. Sent to GitHub as redirect_uri (must match
# the registered callback URL exactly), and an https:// value tells the hub this
# is a TLS deployment so the session cookie is issued with `Secure`.
OAUTH_CALLBACK_URL=

# Origin check on the WS upgrade (B3), fail-closed. A bare origin only —
# scheme + host[:port], no path/query/fragment — or boot refuses. Unset skips
# the check. Set it to the hostname browsers actually load.
HUB_ORIGIN=

# ---------------------------------------------------------------------------
# Retention + backups. THE RECORD IS THE PRODUCT (§8.7), so this is a DOUBLE
# OPT-IN, by deliberate design:
#   - HUB_RETENTION_DAYS unset  → nothing is ever pruned (keep forever).
#   - Backups run at boot BEFORE the prune, so any pruned rows are always
#     recoverable from the latest backup — IF a backup dir is configured.
#   - Setting HUB_RETENTION_DAYS with NO HUB_BACKUP_DIR is the operator's
#     explicit choice to delete event rows UNRECOVERABLY. That is allowed, but
#     it is a choice, not a default — set both together unless you mean it.
# ---------------------------------------------------------------------------

# Positive integer number of days to keep event rows; unset = keep forever.
HUB_RETENTION_DAYS=

# Turns backups on. The dir is the switch; created 0700 if missing, files 0600.
# Hot VACUUM INTO (atomic, single self-contained file). Under /var to stay
# writable with ProtectHome=true. Unset = no backups.
HUB_BACKUP_DIR=/var/backups/multiplayer-ai
# Only tune an already-enabled backup (require HUB_BACKUP_DIR):
#   interval between backups, ms — default 86400000 (24h), floor 60000 (1/min).
HUB_BACKUP_INTERVAL_MS=
#   how many hub-*.db files to keep — default 7, oldest pruned past that.
HUB_BACKUP_KEEP=

# Disk-headroom floor, bytes. Below this the hub REFUSES TO BOOT loudly and
# refuses publishes at runtime instead of crash-looping on a full disk. Default
# 104857600 (100 MiB). Non-negative integer.
HUB_MIN_FREE_BYTES=

# Hub-side oversight (PRD §8.8): the team summarizer runs ON THE HUB with this
# key — one key for the whole team's summaries, owned by the operator. Unset =>
# `set_oversight enabled:true` refuses truthfully and snapshots report
# `available: false`; everything else works without it.
ANTHROPIC_API_KEY=

# Set to exactly 1 when the hub runs behind Caddy (as this deploy does), so
# per-IP rate limits read the real client IP from X-Forwarded-For. Anything
# other than "1" leaves it off — an untrusted client must not pick its own IP.
HUB_TRUST_PROXY=1

# NOT YET VERIFIED against a real box — written during A1a, executed in A1b.
# Install to /etc/multiplayer-ai/env, then: chown mpai:mpai and chmod 0600.
# Never commit a filled-in copy of this file.

# Capped Anthropic Console workspace key. Required whenever CLIENT_DIST is set.
ANTHROPIC_API_KEY=

# Absolute path to the built client. Its presence is what signals production
# mode, which turns config problems into boot failures.
CLIENT_DIST=/opt/multiplayer-ai/poc/client/dist

# Loopback only: the port must be reachable solely through Caddy.
HOST=127.0.0.1
PORT=3001

# Agent working directories.
AGENT_WORKDIR_ROOT=/srv/mpai-work
AGENT_PLUGINS_ROOT=/srv/mpai-plugins

# Single-worktree fallback the agent driver reads directly (agentDriver.ts:133)
# when no per-session workdir is supplied; if this and AGENT_WORKDIR_ROOT are
# both unset the agent runs in the service's own working directory. See the
# A1b blocker in deploy/RUNBOOK.md section 0 before any real session runs.
# AGENT_WORKDIR=

# Optional invite gate. Off unless set to 1. Invites are a capability, NOT
# authentication — real auth is A2.
# REQUIRE_INVITE=1
# INVITE_TTL_MS=86400000
# INVITE_MAX_USES=5

# ---------------------------------------------------------------------------
# GitHub sign-in (A2a). NOT YET VERIFIED against a real GitHub OAuth app.
#
# The four variables below are ALL REQUIRED whenever CLIENT_DIST is set — the
# process exits 1 at boot otherwise. Auth is signalled by GITHUB_CLIENT_ID
# alone; in development you may omit all four, but you may not set some and
# not others (a half-configured deployment would silently run anonymous).
#
# Register the OAuth app first: GitHub → Settings → Developer settings →
# OAuth Apps → New OAuth App.
#   Homepage URL:               https://<domain>
#   Authorization callback URL: https://<domain>/auth/callback   <- exact
# The path is /auth/callback, on the SAME origin that serves the client. Under
# `vite dev` that origin is http://localhost:5173 (poc/client/vite.config.ts
# proxies /auth through to this server), so a dev OAuth app registers
# http://localhost:5173/auth/callback instead.
# ---------------------------------------------------------------------------

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. HIGH ENTROPY, and never a reused password:
#   openssl rand -hex 32
# There is no revocation list (A2a spec §7), so ROTATING THIS SIGNS EVERYONE
# OUT — that is also the only way to revoke a leaked cookie. Sessions last 7
# days. Do not set it with `SESSION_SECRET=$(cat file)`: the trailing newline
# is stripped on load, but keeping the file clean is less surprising.
SESSION_SECRET=

# Who may drive. Comma-separated GitHub logins, case-insensitive, whitespace
# around entries ignored. An EMPTY LIST ADMITS NOBODY — the fail-closed
# direction, not a wildcard. Everyone else gets the "not on the list" screen.
GITHUB_ALLOWLIST=alice,bob

# Optional, but SET IT IN PRODUCTION. Two effects:
#   1. It is sent to GitHub as redirect_uri, so it must match the callback URL
#      registered on the OAuth app EXACTLY or the exchange fails. Left unset,
#      no redirect_uri is sent and GitHub falls back to the registered URL —
#      which is fine when the app has exactly one.
#   2. An https:// value is what tells the server this is a TLS deployment, so
#      the session cookie is issued with `Secure` even if the proxy in front
#      forgets to set x-forwarded-proto. Leaving it unset behind a
#      misconfigured proxy ships the session cookie in the clear.
# The post-login destination (the invite token) travels in its own cookie, so
# it survives the round trip whether or not this is set.
OAUTH_CALLBACK_URL=https://<domain>/auth/callback
